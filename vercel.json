{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix server --include=dev && npm ci --prefix web --include=dev",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{server/node_modules/swagger-ui-dist/**,server/node_modules/.prisma/client/**,server/prisma/schema.prisma}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
